<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Schedulry</AssemblyName>
    <Version>0.1.2</Version>
    <Product>Schedulry</Product>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Generated by tools/icon/render-icon.ps1; rerun it after changing the design. -->
    <ApplicationIcon>Assets\schedulry.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- The 1024 px master is for packaging, not embedded in the app. -->
    <AvaloniaResource Include="Assets\schedulry.ico;Assets\schedulry-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="FluentIcons.Avalonia" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Schedulry.ViewModels\Schedulry.ViewModels.csproj" />
    <ProjectReference Include="..\Schedulry.Windows\Schedulry.Windows.csproj" />
    <ProjectReference Include="..\Schedulry.Demo\Schedulry.Demo.csproj" />
  </ItemGroup>

</Project>
