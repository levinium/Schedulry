<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Schedulry.App.Controls">

  <!-- Text: the window sets the colour and text inherits it. A TextBlock style would override the
       faded colour of a disabled button's label, making it look clickable. -->
  <Style Selector="Window">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Margin" Value="12,14,0,6" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.columnHeader">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Background" Value="{DynamicResource BannerNoteBg}" />
  </Style>
  <Style Selector="Border.banner.info">
    <Setter Property="Background" Value="{DynamicResource BannerInfoBg}" />
  </Style>
  <Style Selector="Border.banner.error">
    <Setter Property="Background" Value="{DynamicResource BannerErrorBg}" />
  </Style>
  <Style Selector="Border.detailSection">
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,14,0,14" />
  </Style>

  <!-- Buttons: always filled. Primary = solid accent; neutral = calm grey. -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentFill}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
  </Style>
  <Style Selector="Button.neutral">
    <Setter Property="Background" Value="{DynamicResource ButtonNeutralBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.neutral:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonNeutralBgHover}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <!-- Danger: maroon fill with white text, for the confirm step of a delete. -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerFill}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFillHover}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <!-- Tabs: a grey track; the chosen tab is a filled card on it. -->
  <Style Selector="Border.tabs">
    <Setter Property="Background" Value="{DynamicResource ButtonNeutralBg}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonNeutralBgHover}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.tab.selected">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- Icon buttons (a row's star, a chip's ×): no fill, the icon is the button. -->
  <Style Selector="Button.star, Button.chipRemove">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.star:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.chipRemove:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
  </Style>
  <Style Selector="Button.chipRemove">
    <Setter Property="Padding" Value="3" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Chip: dot + text on a tinted pill. -->
  <Style Selector="c|Chip">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="8,2,10,2">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Name="dot" Width="7" Height="7" VerticalAlignment="Center" Fill="{TemplateBinding Tag}" />
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|Chip[Kind=Neutral]">
    <Setter Property="Background" Value="{DynamicResource BadgeNeutralBg}" />
    <Setter Property="Foreground" Value="{DynamicResource BadgeNeutralFg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeNeutralBorder}" />
    <Setter Property="Tag" Value="{DynamicResource BadgeNeutralDot}" />
  </Style>
  <Style Selector="c|Chip[Kind=Info]">
    <Setter Property="Background" Value="{DynamicResource BadgeInfoBg}" />
    <Setter Property="Foreground" Value="{DynamicResource BadgeInfoFg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeInfoBorder}" />
    <Setter Property="Tag" Value="{DynamicResource BadgeInfoDot}" />
  </Style>
  <Style Selector="c|Chip[Kind=Success]">
    <Setter Property="Background" Value="{DynamicResource BadgeSuccessBg}" />
    <Setter Property="Foreground" Value="{DynamicResource BadgeSuccessFg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeSuccessBorder}" />
    <Setter Property="Tag" Value="{DynamicResource BadgeSuccessDot}" />
  </Style>
  <Style Selector="c|Chip[Kind=Warning]">
    <Setter Property="Background" Value="{DynamicResource BadgeWarningBg}" />
    <Setter Property="Foreground" Value="{DynamicResource BadgeWarningFg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeWarningBorder}" />
    <Setter Property="Tag" Value="{DynamicResource BadgeWarningDot}" />
  </Style>
  <Style Selector="c|Chip[Kind=Danger]">
    <Setter Property="Background" Value="{DynamicResource BadgeDangerBg}" />
    <Setter Property="Foreground" Value="{DynamicResource BadgeDangerFg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeDangerBorder}" />
    <Setter Property="Tag" Value="{DynamicResource BadgeDangerDot}" />
  </Style>
  <!-- Running: the dot breathes, so a running task catches the eye without flashing. -->
  <Style Selector="c|Chip[Kind=Info] /template/ Ellipse#dot">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Ellipse.livePulse">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.3" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Sidebar lists -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NavSelectedFg}" />
  </Style>

  <!-- The task table. A size smaller than the rest of the app, so names fit. Each cell's Border
       fills the cell, so a row that just changed glows from edge to edge. -->
  <Style Selector="DataGrid.tasks">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RowBackground" Value="Transparent" />
  </Style>
  <Style Selector="DataGrid.tasks DataGridColumnHeader">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="DataGrid.tasks DataGridCell">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="DataGrid.tasks DataGridCell:focus /template/ Grid#FocusVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="DataGrid.tasks DataGridRow">
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style Selector="DataGrid.tasks DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource RowSelectedBg}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGrid.tasks DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource RowHoverBg}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.cell">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- A run just started or finished: the status badge pulses twice, nothing else moves. -->
  <Style Selector="c|Chip.flash">
    <Style.Animations>
      <Animation Duration="0:0:0.6" IterationCount="2" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.35" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.cell TextBlock">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Border.cell TextBlock.muted">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.cell c|Chip">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.cell c|Chip TextBlock">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.cell Button.star">
    <Setter Property="Padding" Value="2" />
  </Style>

  <!-- The divider between table and preview: invisible until pointed at, then a slim accent bar. -->
  <Style Selector="GridSplitter.divider">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Name="bar" Width="3" CornerRadius="2" Margin="0,40" Background="Transparent" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.divider:pointerover /template/ Border#bar">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>
  <!-- Editor -->
  <Style Selector="Border.editorCard">
    <Setter Property="Padding" Value="18,16" />
  </Style>
  <Style Selector="Border.subCard">
    <Setter Property="Background" Value="{DynamicResource SubtleBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <!-- Choices shown as cards: every option visible with what it means; the chosen one outlined. -->
  <Style Selector="ListBox.options">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.options ListBoxItem">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
  </Style>
  <Style Selector="ListBox.options ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="ListBox.options ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Search box -->
  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Scrollbars -->
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource ScrollThumb}" />
  </Style>
</Styles>
