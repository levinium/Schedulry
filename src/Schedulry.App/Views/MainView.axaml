<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Schedulry.ViewModels"
             xmlns:c="using:Schedulry.App.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:views="using:Schedulry.App.Views"
             xmlns:ed="using:Schedulry.ViewModels.Editor"
             x:Class="Schedulry.App.Views.MainView"
             x:DataType="vm:MainViewModel">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Top bar: name, computer, live state; new task, import, settings. Search and sort sit on the table. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,12,16,10" ColumnSpacing="14">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="/Assets/schedulry-256.png" Width="30" Height="30" />
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="Schedulry" FontSize="16" FontWeight="SemiBold" />
          <!-- The computer being looked at; opens the Computers card to switch. -->
          <Button Classes="neutral small" Padding="6,1" Command="{Binding ToggleComputersCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <ic:FluentIcon Icon="Desktop" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsLocal}" />
              <ic:FluentIcon Icon="Server" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsRemote}" />
              <TextBlock FontSize="12" Text="{Binding ComputerName}" VerticalAlignment="Center" />
              <ic:FluentIcon Icon="ChevronDown" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>

      <Border Grid.Column="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Background="{DynamicResource BadgeInfoBg}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Classes="livePulse" Width="8" Height="8" Fill="{DynamicResource BadgeInfoDot}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding LiveText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BadgeInfoFg}" />
        </StackPanel>
      </Border>


      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Button Classes="primary" Command="{Binding NewTaskCommand}" IsEnabled="{Binding IsBrowsing}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:FluentIcon Icon="Add" FontSize="14" />
            <TextBlock Text="New Task" />
          </StackPanel>
        </Button>
        <Button Classes="neutral" Content="Import…" Command="{Binding ImportTaskCommand}" IsEnabled="{Binding IsBrowsing}" />
        <!-- Settings: the gear alone. -->
        <Button Classes="neutral" Padding="9,8" Command="{Binding ToggleSettingsCommand}" AutomationProperties.Name="Settings">
          <ic:FluentIcon Icon="Settings" FontSize="16" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Banners: admin rights, history log, a problem reading. -->
    <StackPanel Grid.Row="1" Margin="16,0,16,8" Spacing="8">
      <!-- Settings: alerts, the notification area, starting with Windows. For the whole app, whichever computer is showing. -->
      <Border Classes="card" Padding="16,12" IsVisible="{Binding ShowSettings}">
        <StackPanel Spacing="10" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="Settings" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="neutral small" Content="Close"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ToggleSettingsCommand}" />
          </Grid>
          <WrapPanel ItemSpacing="28" LineSpacing="12">
            <StackPanel Width="330" Spacing="2">
              <CheckBox IsChecked="{Binding NotifyFailures}" Content="Notify me when a task fails" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="28,0,0,0"
                         Text="A Windows notification for each failed run. To stop them for one task, use Alerts in its preview." />
              <CheckBox IsChecked="{Binding NotifyWindowsTasks}" IsEnabled="{Binding NotifyFailures}" Content="Include Windows' own tasks"
                        Margin="28,6,0,0" />
            </StackPanel>
            <StackPanel Width="330" Spacing="2">
              <CheckBox IsChecked="{Binding KeepRunningWhenClosed}" Content="Keep running when the window is closed" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="28,0,0,0"
                         Text="Schedulry stays in the notification area and keeps watching. Exit it from its icon there." />
            </StackPanel>
            <StackPanel Width="330" Spacing="2">
              <CheckBox IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanChange}" Content="Start with Windows" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="28,0,0,0"
                         Text="Starts in the notification area when you sign in, so failures are noticed without opening it." />
            </StackPanel>
            <StackPanel Width="330" Spacing="2">
              <CheckBox IsChecked="{Binding AlwaysRunAsAdmin}" IsEnabled="{Binding CanChange}" Content="Always run as administrator" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="28,0,0,0"
                         Text="Opens with full rights, so every task can be changed. Windows asks for approval each time you open Schedulry. With Start with Windows on, it starts this way at sign-in without asking (through a task in Task Scheduler)." />
            </StackPanel>
            <StackPanel Width="330" Spacing="2">
              <CheckBox IsChecked="{Binding AllowRemote}" IsEnabled="{Binding CanChange}" Content="Let other computers manage this PC's tasks" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="28,0,0,0"
                         Text="Opens Windows Firewall for remote task management and run history. Asks for administrator approval. Other computers still need an administrator account on this PC." />
              <CheckBox IsChecked="{Binding AllowLocalAdmins}" IsEnabled="{Binding CanChange}" Content="Also let this PC's own administrator accounts connect"
                        Margin="28,6,0,0" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="56,0,0,0"
                         Text="Only needed when connecting as a local account such as .\Admin; domain accounts work without it. Windows normally removes a local account's administrator rights over the network, so a stolen local password reaches less. Turn on only if you need it." />
            </StackPanel>
          </WrapPanel>
          <Border Classes="banner error" IsVisible="{Binding HasProblem}">
            <c:ErrorText Text="{Binding Problem}" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="12"
                      DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Update}" x:DataType="vm:AppUpdate">
            <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding VersionText}" />
            <Button Classes="neutral small" Content="Check for Updates" IsVisible="{Binding CanCheck}" Command="{Binding CheckNowCommand}" />
            <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding CheckText}" IsVisible="{Binding CheckText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="16,12" IsVisible="{Binding IsImporting}">
        <StackPanel Spacing="8" DataContext="{Binding Import}" x:DataType="ed:ImportViewModel">
          <TextBlock Classes="h2" Text="{Binding FileName, StringFormat='Import {0}'}" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="The task is added exactly as the file describes it. Choose its name and folder." />
          <WrapPanel ItemSpacing="12" LineSpacing="8">
            <StackPanel Spacing="4">
              <TextBlock Classes="fieldLabel" Text="Name" />
              <TextBox Text="{Binding Name}" Width="280" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="fieldLabel" Text="Folder" />
              <views:FolderPickerView DataContext="{Binding FolderPicker}" Width="400" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding NeedsPassword}">
              <TextBlock Classes="fieldLabel" Text="The account's password (not kept)" />
              <TextBox Text="{Binding Password}" PasswordChar="•" Width="240" />
            </StackPanel>
          </WrapPanel>
          <Border Classes="banner error" IsVisible="{Binding HasProblem}">
            <c:ErrorText Text="{Binding Problem}" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Import Task" Command="{Binding ImportCommand}" />
            <Button Classes="neutral" Content="Cancel" Command="{Binding CancelCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- A newer version has downloaded. -->
      <Border Classes="banner info" IsVisible="{Binding Update.IsReady}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <ic:FluentIcon Icon="ArrowDownload" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Update.ReadyText}" />
          <Button Grid.Column="2" Classes="primary" Content="Restart to Update" Command="{Binding Update.RestartCommand}" />
        </Grid>
      </Border>
      <Border Classes="banner error" IsVisible="{Binding HasLiveProblem}">
        <c:ErrorText Text="{Binding LiveProblem}" />
      </Border>
      <Border Classes="banner error" IsVisible="{Binding HasBannerProblem}">
        <c:ErrorText Text="{Binding BannerProblem}" />
      </Border>
      <Border Classes="banner" IsVisible="{Binding ShowAdminBanner}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <ic:FluentIcon Icon="ShieldPerson" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Running without administrator rights. You can see most tasks, but only change the ones that run as you." />
          <Button Grid.Column="2" Classes="primary" Content="Restart as Administrator" Command="{Binding RestartAsAdminCommand}" />
        </Grid>
      </Border>
      <Border Classes="banner info" IsVisible="{Binding ShowHistoryBanner}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <ic:FluentIcon Icon="History" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource BadgeWarningFg}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="{Binding HistoryBannerText}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Turn On History" Command="{Binding TurnOnHistoryCommand}" />
            <Button Classes="neutral" Content="Not Now" Command="{Binding DismissHistoryBannerCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Body: sidebar | list | preview -->
    <Grid Grid.Row="2" Name="BodyGrid" ColumnDefinitions="196,12,*,12,360" Margin="16,0,16,16" IsVisible="{Binding IsBrowsing}">

      <Border Classes="card" Background="{DynamicResource SidebarBg}">
        <ScrollViewer>
          <StackPanel Margin="0,0,0,10">
            <!-- Windows' own tasks change every list and count, so the switch sits above them. -->
            <ToggleSwitch IsChecked="{Binding ShowWindowsTasks}" OnContent="Windows tasks" OffContent="Windows tasks" Margin="14,8,12,0" />
            <TextBlock Classes="section" Text="STATUS" />
            <ListBox Classes="nav" ItemsSource="{Binding Views}" SelectedItem="{Binding HighlightedView}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ViewItem">
                  <Grid ColumnDefinitions="*,Auto" Margin="10,0">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Count}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Classes="section" Text="MY TASKS" />
            <!-- Tasks dragged from the table drop onto Starred or a group. -->
            <ListBox Name="CollectionList" Classes="nav" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" DragDrop.AllowDrop="True">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CollectionItem">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,0,0">
                    <ic:FluentIcon Icon="Star" IconVariant="Filled" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BadgeWarningDot}" IsVisible="{Binding IsStarredList}" />
                    <ic:FluentIcon Icon="Collections" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" IsVisible="{Binding IsGroup}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Count}" Margin="6,0,10,0" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Classes="neutral small" Margin="12,4,12,0" HorizontalAlignment="Left" Command="{Binding StartNewGroupCommand}"
                    IsVisible="{Binding !IsCreatingGroup}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:FluentIcon Icon="Add" FontSize="12" />
                <TextBlock Text="New Group" />
              </StackPanel>
            </Button>
            <StackPanel Margin="12,4,12,0" Spacing="6" IsVisible="{Binding IsCreatingGroup}">
              <TextBox Text="{Binding NewGroupName}" Watermark="Group name, such as Backups" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="primary small" Content="Create" Command="{Binding CreateGroupCommand}" IsDefault="True" />
                <Button Classes="neutral small" Content="Cancel" Command="{Binding CancelNewGroupCommand}" />
              </StackPanel>
            </StackPanel>

            <TextBlock Classes="section" Text="FOLDERS" />
            <ListBox Classes="nav" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderItem">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="{Binding Indent, Converter={x:Static c:Converters.LeftMargin}}">
                    <ic:FluentIcon Icon="Folder" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Count}" Margin="6,0,10,0" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- The live list -->
      <Border Grid.Column="2" Classes="card" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*">
          <!-- Tasks or Recent Activity; beside them, what the list shows (and a group's own tools). -->
          <Grid ColumnDefinitions="Auto,*" Margin="12,10,12,8" ColumnSpacing="14">
          <Border Classes="tabs" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="tab" Classes.selected="{Binding ShowTaskList}" Content="Tasks" Command="{Binding ShowTasksCommand}" />
              <Button Classes="tab" Classes.selected="{Binding ShowActivity}" Content="Recent Activity" Command="{Binding ShowRecentActivityCommand}" />
            </StackPanel>
          </Border>
          <TextBlock Grid.Column="1" Classes="secondary" FontSize="12" Text="{Binding ActivityNote}" IsVisible="{Binding ShowActivity}"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" MinHeight="32" IsVisible="{Binding ShowTaskList}">
            <TextBlock Text="{Binding ScopeTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowGroupTools}">
              <Button Classes="neutral small" Content="Rename Group" Command="{Binding StartRenameCommand}" />
              <Button Classes="neutral small" Content="Delete Group" Command="{Binding AskDeleteGroupCommand}" />
            </StackPanel>
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRenamingGroup}">
              <TextBox Text="{Binding RenameText}" Width="260" />
              <Button Classes="primary small" Content="Save" Command="{Binding SaveRenameCommand}" IsDefault="True" />
              <Button Classes="neutral small" Content="Cancel" Command="{Binding CancelRenameCommand}" />
            </StackPanel>
            <Border Grid.ColumnSpan="2" Classes="banner info" Padding="12,6" IsVisible="{Binding IsConfirmingDelete}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding DeleteQuestion}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="danger small" Content="Delete Group" Command="{Binding ConfirmDeleteGroupCommand}" />
                  <Button Classes="neutral small" Content="Keep It" Command="{Binding CancelDeleteGroupCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
          </Grid>

          <!-- Search and sort, right above what they act on. Search finds tasks and runs alike. -->
          <Grid Grid.Row="1" ColumnSpacing="12" Margin="12,0,12,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4*" MaxWidth="440" />
              <ColumnDefinition Width="*" MinWidth="0" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
              <TextBox Name="SearchBox" Classes="search" Text="{Binding SearchText}" Watermark="Search tasks"
                       Padding="34,6,34,6" />
              <ic:FluentIcon Icon="Search" FontSize="14" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False" />
              <Button Classes="neutral small" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="6,2"
                      AutomationProperties.Name="Clear search" Command="{Binding ClearSearchCommand}"
                      IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <ic:FluentIcon Icon="Dismiss" FontSize="12" />
              </Button>
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding ShowTaskList}">
              <TextBlock Classes="secondary" Text="Sort by" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" MinWidth="120">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SortOption">
                    <TextBlock Text="{Binding Title}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="neutral" Command="{Binding ToggleSortDirectionCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ic:FluentIcon Icon="ArrowSort" FontSize="14" />
                  <TextBlock Text="{Binding SortDirectionText}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- The table: drag a column's edge to resize it (widths are remembered); sort with "Sort by". -->
          <DataGrid Grid.Row="2" Name="TaskGrid" Classes="tasks" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsVisible="{Binding ShowTaskList}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserResizeColumns="True"
                    CanUserReorderColumns="True" CanUserSortColumns="False" GridLinesVisibility="None" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Status" Tag="status" Width="128" MinWidth="124">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:TaskRowViewModel">
                    <Border Classes="cell">
                      <c:Chip Kind="{Binding StatusKind}" Content="{Binding StatusText}" Classes.flash="{Binding IsFlashing}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Task" Tag="task" Width="2.4*" MinWidth="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:TaskRowViewModel">
                    <Border Classes="cell">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Button Classes="star" VerticalAlignment="Center" CommandParameter="{Binding}"
                                Command="{Binding #TaskGrid.((vm:MainViewModel)DataContext).ToggleStarCommand}">
                          <Panel>
                            <ic:FluentIcon Icon="Star" IconVariant="Filled" FontSize="14" Foreground="{DynamicResource BadgeWarningDot}" IsVisible="{Binding IsStarred}" />
                            <ic:FluentIcon Icon="Star" FontSize="14" Foreground="{DynamicResource TextMuted}" IsVisible="{Binding !IsStarred}" />
                          </Panel>
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Schedule" Tag="schedule" Width="1.6*" MinWidth="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:TaskRowViewModel">
                    <Border Classes="cell">
                      <TextBlock Classes="secondary" Text="{Binding ScheduleText}" TextWrapping="WrapWithOverflow" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Last Run" Tag="lastrun" Width="1*" MinWidth="88">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:TaskRowViewModel">
                    <Border Classes="cell">
                      <TextBlock Classes="secondary" Text="{Binding LastRunText}" TextWrapping="WrapWithOverflow" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Last Result" Tag="result" Width="1*" MinWidth="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:TaskRowViewModel">
                    <Border Classes="cell">
                      <TextBlock Classes="secondary" Text="{Binding ResultShort}" TextWrapping="WrapWithOverflow" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Next Run" Tag="nextrun" Width="1*" MinWidth="88">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:TaskRowViewModel">
                    <Border Classes="cell">
                      <TextBlock Classes="secondary" Text="{Binding NextRunText}" TextWrapping="WrapWithOverflow" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Recent Activity: every run, newest first. Selecting one shows its task in the preview. -->
          <DataGrid Grid.Row="2" Classes="tasks" ItemsSource="{Binding Activity}" SelectedItem="{Binding SelectedActivity}"
                    IsVisible="{Binding ShowActivity}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False" GridLinesVisibility="None" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="When" Width="1*" MinWidth="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:RunLine">
                    <Border Classes="cell">
                      <TextBlock Classes="secondary" Text="{Binding WhenText}" TextWrapping="WrapWithOverflow" VerticalAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Task" Width="2.2*" MinWidth="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:RunLine">
                    <Border Classes="cell">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="What Happened" Width="1.6*" MinWidth="130">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:RunLine">
                    <Border Classes="cell">
                      <c:Chip Kind="{Binding Kind}" Content="{Binding WhatText}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Took" Width="0.8*" MinWidth="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:RunLine">
                    <Border Classes="cell">
                      <TextBlock Classes="secondary" Text="{Binding TookText}" TextWrapping="WrapWithOverflow" VerticalAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Why" Width="0.9*" MinWidth="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:RunLine">
                    <Border Classes="cell">
                      <TextBlock Classes="secondary" Text="{Binding CauseText}" TextWrapping="WrapWithOverflow" VerticalAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" Classes="secondary" Text="{Binding ActivityEmptyText}" IsVisible="{Binding ActivityEmpty}" TextWrapping="Wrap"
                     MaxWidth="420" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />

          <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding IsLoading}">
            <ProgressBar IsIndeterminate="True" Width="200" />
            <TextBlock Classes="secondary" Text="Reading tasks…" HorizontalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Row="2" Classes="secondary" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap"
                     MaxWidth="420" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- Drag to share the width between the table and the preview (remembered). -->
      <GridSplitter Grid.Column="3" Classes="divider" ResizeDirection="Columns" />

      <!-- Preview -->
      <Border Grid.Column="4" Classes="card" MinWidth="300">
        <Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !HasDetail}" Margin="24">
            <ic:FluentIcon Icon="CalendarClock" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
            <TextBlock Classes="secondary" Text="Select a task to see when it runs, what it does and how its last run went." TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
          <!-- Several tasks selected: what can be done to all of them. -->
          <ScrollViewer IsVisible="{Binding HasMultiple}">
            <StackPanel Margin="20,18,20,8" Spacing="10">
              <TextBlock Classes="h1" Text="{Binding SelectionText}" />
              <TextBlock Classes="secondary" TextWrapping="Wrap"
                         Text="Add them to a group here, right-click them for more, or drag them onto a group in the sidebar. Shift-click selects a range; Ctrl-click adds or removes one." />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Classes="neutral" Command="{Binding ToggleSelectionStarCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="Star" FontSize="14" />
                    <TextBlock Text="{Binding SelectionStarText}" />
                  </StackPanel>
                </Button>
                <Button Classes="neutral" Content="{Binding RemoveSelectionText}" Command="{Binding RemoveSelectionFromGroupCommand}"
                        IsVisible="{Binding CanRemoveSelectionFromGroup}" />
              </WrapPanel>
              <Separator Margin="0,6" />
              <TextBlock Classes="h2" Text="Add to a Group" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <AutoCompleteBox Text="{Binding SelectionGroupText}" ItemsSource="{Binding GroupNames}" FilterMode="ContainsOrdinal"
                                 Watermark="A group's name, new or existing" />
                <Button Grid.Column="1" Classes="primary" Content="Add to Group" Command="{Binding AddSelectionToGroupCommand}" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
          <ContentControl Content="{Binding Detail}" IsVisible="{Binding ShowSingleDetail}">
            <ContentControl.DataTemplates>
              <DataTemplate x:DataType="vm:TaskDetailViewModel">
                <ScrollViewer>
                  <StackPanel Margin="20,18,20,8">
                    <TextBlock Classes="h1" Text="{Binding Row.Name}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding Row.Path}" TextWrapping="Wrap" Margin="0,2,0,10" />
                    <c:Chip Kind="{Binding Row.StatusKind}" Content="{Binding Row.StatusText}" />
                    <TextBlock Classes="secondary" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" Margin="0,12,0,0" />

                    <WrapPanel Margin="0,14,0,0" ItemSpacing="8" LineSpacing="8">
                      <Button Classes="primary" Command="{Binding RunCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ic:FluentIcon Icon="Play" FontSize="14" />
                          <TextBlock Text="Run Now" />
                        </StackPanel>
                      </Button>
                      <Button Command="{Binding EndCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ic:FluentIcon Icon="Stop" FontSize="14" />
                          <TextBlock Text="End" />
                        </StackPanel>
                      </Button>
                      <Button Classes="neutral" Content="Turn Off" Command="{Binding TurnOffCommand}" IsVisible="{Binding Row.Task.Enabled}" />
                      <Button Classes="neutral" Command="{Binding ToggleStarCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Panel>
                            <ic:FluentIcon Icon="Star" IconVariant="Filled" FontSize="14" Foreground="{DynamicResource BadgeWarningDot}" IsVisible="{Binding Row.IsStarred}" />
                            <ic:FluentIcon Icon="Star" FontSize="14" IsVisible="{Binding !Row.IsStarred}" />
                          </Panel>
                          <TextBlock Text="{Binding StarText}" />
                        </StackPanel>
                      </Button>
                      <Button Classes="neutral" Command="{Binding ToggleNotifyCommand}" IsVisible="{Binding CanNotify}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Panel>
                            <ic:FluentIcon Icon="Alert" FontSize="14" IsVisible="{Binding Notifies}" />
                            <ic:FluentIcon Icon="AlertOff" FontSize="14" IsVisible="{Binding !Notifies}" />
                          </Panel>
                          <TextBlock Text="{Binding NotifyText}" />
                        </StackPanel>
                      </Button>
                      <Button Content="Turn On" Command="{Binding TurnOnCommand}" IsVisible="{Binding !Row.Task.Enabled}" />
                      <Button Classes="neutral" Content="Edit" Command="{Binding EditCommand}" />
                      <Button Classes="neutral" Content="Copy…" Command="{Binding CopyCommand}" />
                      <Button Classes="neutral" Content="Delete…" Command="{Binding AskDeleteCommand}" />
                    </WrapPanel>
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding ActionNote}" IsVisible="{Binding HasActionNote}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Border Classes="banner info" IsVisible="{Binding IsConfirmingDelete}" Margin="0,10,0,0">
                      <StackPanel Spacing="10">
                        <TextBlock TextWrapping="Wrap">
                          <Run Text="Delete " /><Run Text="{Binding Row.Name}" FontWeight="SemiBold" /><Run Text=" from Task Scheduler? This can't be undone. Saving a copy first lets you import it again later." />
                        </TextBlock>
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                          <Button Classes="neutral small" Content="Save a Copy First" Command="{Binding SaveCopyCommand}" />
                          <Button Classes="danger small" Content="Delete Task" Command="{Binding ConfirmDeleteCommand}" />
                          <Button Classes="neutral small" Content="Keep It" Command="{Binding CancelDeleteCommand}" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Border Classes="banner error" IsVisible="{Binding HasProblem}" Margin="0,10,0,0">
                      <c:ErrorText Text="{Binding Problem}" />
                    </Border>

                    <Border Classes="detailSection" Margin="0,16,0,0">
                      <StackPanel Spacing="6">
                        <TextBlock Classes="h2" Text="Groups" />
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasGroups}"
                                   Text="Not in any of your groups. Groups are kept by Schedulry only; the task itself doesn't change." />
                        <ItemsControl ItemsSource="{Binding Groups}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel ItemSpacing="6" LineSpacing="6" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CollectionItem">
                              <Border Background="{DynamicResource BadgeNeutralBg}" BorderBrush="{DynamicResource BadgeNeutralBorder}" BorderThickness="1"
                                      CornerRadius="12" Padding="10,2,4,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                  <Button Classes="chipRemove" CommandParameter="{Binding}"
                                          Command="{Binding $parent[ItemsControl].((vm:TaskDetailViewModel)DataContext).RemoveFromGroupCommand}">
                                    <ic:FluentIcon Icon="Dismiss" FontSize="10" />
                                  </Button>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <AutoCompleteBox Text="{Binding GroupNameText}" ItemsSource="{Binding GroupNames}" FilterMode="ContainsOrdinal"
                                           MinimumPrefixLength="0" Watermark="A group's name, new or existing" />
                          <Button Grid.Column="1" Content="Add to Group" Command="{Binding AddToGroupCommand}" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Classes="detailSection">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="h2" Text="Last Run" />
                        <TextBlock Text="{Binding ResultTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="secondary" Text="{Binding ResultDetail}" IsVisible="{Binding HasResultDetail}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding LastRunFull}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding ResultCode}" />
                      </StackPanel>
                    </Border>

                    <Border Classes="detailSection">
                      <StackPanel Spacing="6">
                        <TextBlock Classes="h2" Text="Run History" />
                        <StackPanel Spacing="8" IsVisible="{Binding HistoryOff}">
                          <TextBlock Classes="secondary" TextWrapping="Wrap"
                                     Text="Windows isn't keeping task history, so past runs can't be shown. Turn it on to record every run from now on." />
                          <Button Classes="primary small" Content="Turn On History" Command="{Binding TurnOnHistoryCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock Classes="muted" Text="Reading the history…" IsVisible="{Binding RunsLoading}" />
                        <TextBlock Classes="muted" Text="No runs in the last 30 days." IsVisible="{Binding NoRuns}" />
                        <ItemsControl ItemsSource="{Binding Runs}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RunLine">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,3">
                                <StackPanel>
                                  <TextBlock Text="{Binding WhenText}" FontWeight="SemiBold" FontSize="13" />
                                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap">
                                    <Run Text="{Binding CauseText}" /><Run Text="  " /><Run Text="{Binding TookText}" />
                                  </TextBlock>
                                </StackPanel>
                                <c:Chip Grid.Column="1" Kind="{Binding Kind}" Content="{Binding WhatText}" VerticalAlignment="Top" MaxWidth="190" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>

                    <Border Classes="detailSection">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="h2" Text="When It Runs" />
                        <ItemsControl ItemsSource="{Binding Triggers}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                                <ic:FluentIcon Icon="Clock" FontSize="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="secondary" FontWeight="SemiBold" FontSize="12" Text="Next runs" Margin="0,8,0,0" />
                        <TextBlock Classes="muted" Text="Working them out…" IsVisible="{Binding NextRunsLoading}" />
                        <TextBlock Classes="muted" Text="Nothing scheduled." IsVisible="{Binding NoNextRuns}" />
                        <ItemsControl ItemsSource="{Binding NextRuns}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Classes="secondary" Text="{Binding}" Margin="0,1" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>

                    <Border Classes="detailSection">
                      <StackPanel Spacing="6">
                        <TextBlock Classes="h2" Text="What It Does" />
                        <ItemsControl ItemsSource="{Binding Actions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DetailLine">
                              <Border Background="{DynamicResource SubtleBg}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel Spacing="2">
                                  <SelectableTextBlock Text="{Binding Label}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                  <TextBlock Classes="muted" FontSize="12" Text="{Binding Value}" IsVisible="{Binding Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>

                    <Border Classes="detailSection">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="h2" Text="Runs As" />
                        <TextBlock Text="{Binding RunAsTitle}" FontWeight="SemiBold" />
                        <TextBlock Classes="secondary" Text="{Binding RunAsExplanation}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Classes="detailSection">
                      <StackPanel Spacing="6">
                        <TextBlock Classes="h2" Text="Settings" />
                        <ItemsControl ItemsSource="{Binding Settings}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DetailLine">
                              <Grid ColumnDefinitions="130,*" Margin="0,2">
                                <TextBlock Classes="muted" Text="{Binding Label}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Grid>
      </Border>
    </Grid>
    <!-- The editor takes the place of the sidebar, list and preview while it's open. -->
    <views:EditorView Grid.Row="2" Margin="16,0,16,16" DataContext="{Binding Editor}" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsEditing}" />
    <!-- Computers: a panel dropped from the computer's name, over the page. Clicking outside or
         Escape closes it. -->
    <Grid Grid.Row="1" Grid.RowSpan="2" ZIndex="10" IsVisible="{Binding ShowComputers}">
      <Border Name="ComputersScrim" Background="{DynamicResource Scrim}" PointerPressed="OnComputersScrimPressed" />
      <Border Classes="popover" Width="460" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel DataContext="{Binding Computers}" x:DataType="vm:ComputersViewModel">
          <Grid ColumnDefinitions="*,Auto" Margin="16,12,10,6">
            <TextBlock Text="Switch Computer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="chipRemove" Padding="6" AutomationProperties.Name="Close"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ToggleComputersCommand}">
              <ic:FluentIcon Icon="Dismiss" FontSize="12" />
            </Button>
          </Grid>

          <!-- Each computer is one row: click it to open. The one showing is tinted and ticked. -->
          <ItemsControl ItemsSource="{Binding Rows}" Margin="8,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ComputerRow">
                <Grid Margin="0,1">
                  <Button Classes="pickRow" IsVisible="{Binding CanConnect}" AutomationProperties.Name="{Binding Title}"
                          Command="{Binding $parent[ItemsControl].((vm:ComputersViewModel)DataContext).ConnectToCommand}"
                          CommandParameter="{Binding}" />
                  <Border Classes="pickRowCurrent" IsVisible="{Binding IsCurrent}" />
                  <Grid ColumnDefinitions="Auto,*,26" ColumnSpacing="10" Margin="10,7,8,7" IsHitTestVisible="False">
                    <ic:FluentIcon Icon="Desktop" FontSize="18" VerticalAlignment="Center" IsVisible="{Binding IsThisComputer}"
                                   Foreground="{DynamicResource TextMuted}" />
                    <ic:FluentIcon Icon="Server" FontSize="18" VerticalAlignment="Center" IsVisible="{Binding !IsThisComputer}"
                                   Foreground="{DynamicResource TextMuted}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <ic:FluentIcon Icon="Key" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"
                                       IsVisible="{Binding HasSavedPassword}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </StackPanel>
                    <ic:FluentIcon Grid.Column="2" Icon="Checkmark" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Accent}" IsVisible="{Binding IsCurrent}" />
                  </Grid>
                  <Button Classes="chipRemove" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Padding="5"
                          IsVisible="{Binding CanForget}" AutomationProperties.Name="Forget this computer"
                          Command="{Binding $parent[ItemsControl].((vm:ComputersViewModel)DataContext).ForgetCommand}"
                          CommandParameter="{Binding}">
                    <ic:FluentIcon Icon="Dismiss" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1" Background="{DynamicResource Divider}" Margin="0,8,0,0" />

          <!-- Another computer: its name and Connect on one line; another account only when asked. -->
          <StackPanel Margin="16,12,16,14" Spacing="8">
            <TextBlock Classes="fieldLabel" Text="Connect to Another Computer" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsEnabled="{Binding IsIdle}">
              <TextBox Text="{Binding Name}" Watermark="Computer name or IP address" />
              <Button Grid.Column="1" Classes="primary" Content="Connect" Command="{Binding ConnectCommand}" IsDefault="True" />
            </Grid>
            <CheckBox IsChecked="{Binding UseOtherAccount}" IsEnabled="{Binding IsIdle}" Content="Sign in as another account" />
            <StackPanel Spacing="6" Margin="28,0,0,0" IsVisible="{Binding UseOtherAccount}" IsEnabled="{Binding IsIdle}">
              <TextBox Text="{Binding Account}" Watermark="Account, such as DOMAIN
ame or .
ame" />
              <TextBox Text="{Binding Password}" PasswordChar="•" Watermark="Password" />
              <CheckBox IsChecked="{Binding RememberPassword}" Content="Remember the password on this PC" />
            </StackPanel>
            <TextBlock Classes="muted" FontSize="12" Text="{Binding ConnectHint}"
                       IsVisible="{Binding ConnectHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding IsConnecting}">
              <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding ConnectingText}" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Classes="neutral small" Content="Stop" Command="{Binding CancelConnectCommand}" />
            </Grid>
            <Border Classes="banner error" IsVisible="{Binding HasProblem}">
              <c:ErrorText Text="{Binding Problem}" />
            </Border>
            <Border Classes="banner info" IsVisible="{Binding HasNote}">
              <TextBlock Text="{Binding Note}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:FluentIcon Icon="Info" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource TextMuted}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Width="400"
                         Text="Needs an administrator account on that computer. A remembered password stays in Windows Credential Manager on this PC only." />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</UserControl>
