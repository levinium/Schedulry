<Project>
  <!-- Central package management: every version is set once, here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="FluentIcons.Avalonia" Version="2.1.344" />
    <!-- Managed wrapper over the Windows Task Scheduler COM API; MIT licence. -->
    <PackageVersion Include="TaskScheduler" Version="2.12.2" />
    <PackageVersion Include="System.Diagnostics.EventLog" Version="10.0.0" />
    <!-- Windows notifications from a desktop app, with click handling; MIT licence. -->
    <PackageVersion Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- It asks for System.Drawing.Common 4.7, which has a known flaw; the current one replaces it. -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.0" />
    <!-- Installer and self-update; MIT licence. Keep in step with vpk in .config/dotnet-tools.json. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
